# Keeps the noah-mqtt container alive: starts it via docker compose and waits for it to exit.
# If the container dies, systemd restarts it after 6 minutes.
# Installation: adjust the path in WorkingDirectory, copy to /etc/systemd/system/,
#   sudo systemctl daemon-reload && sudo systemctl enable --now noah-mqtt
[Unit]
Description=noah-mqtt Docker Compose Watchdog
Requires=docker.service
After=docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/noah-zero-export/docker

Restart=always
RestartSec=360
ExecStartPre=-/usr/bin/docker compose up -d noah-mqtt
ExecStart=/usr/bin/docker wait noah-mqtt
ExecStop=/usr/bin/docker compose stop noah-mqtt

[Install]
WantedBy=multi-user.target
